# ============================================================
# LANS (L*) — Environment Configuration Template
# Copy this file to .env and fill in real values locally.
# .env is gitignored — NEVER commit real secrets.
# ============================================================

# DATABASE_URL: Postgres connection string (Supabase transaction pooler, port 6543).
# Optional — the app falls back to an in-memory seed store when unset.
DATABASE_URL=""

# NODE_ENV: development | production. Controls Vite dev middleware vs static dist serving.
NODE_ENV="development"

# DISABLE_HMR: set "true" in AI Studio to disable Vite HMR + file watching.
DISABLE_HMR="false"

# PORT: HTTP port for the Express server (default 3000).
PORT="3000"

# BSC RPC endpoints (comma-separated list). Defaults to public endpoints.
BSC_MAINNET_RPC_URLS="https://binance.llamarpc.com,https://bsc-dataseed.binance.org"
BSC_TESTNET_RPC_URLS="https://data-seed-prebsc-1-s1.binance.org:8545,https://bsc-testnet.publicnode.com"

# SCAN_8004_API_URL: ERC-8004 indexer API base URL.
SCAN_8004_API_URL="https://api.8004scan.io/api/v1"

# GEMINI_API_KEY: Reserved for Gemini AI API calls (not read by app code yet).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (reserved, not read by app code yet).
APP_URL=""
